{
  "name": "personal-os",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "tsx": "^4.23.13",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.5",
      "ai": "^7.0.93",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "auth:generate": "cd apps/server && bun run auth:generate",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:down": "turbo run db:down -F @personal-os/db --",
    "db:generate": "turbo run db:generate -F @personal-os/db --",
    "db:migrate": "turbo run db:migrate -F @personal-os/db --",
    "db:push": "turbo run db:push -F @personal-os/db --",
    "db:start": "turbo run db:start -F @personal-os/db --",
    "db:stop": "turbo run db:stop -F @personal-os/db --",
    "db:studio": "turbo run db:studio -F @personal-os/db --",
    "db:watch": "turbo run db:watch -F @personal-os/db --",
    "deploy": "bunx vercel deploy",
    "deploy:check": "bunx vercel deploy --dry",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:setup": "bunx vercel link",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:vercel": "bunx vercel dev -L",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@personal-os/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "tsx": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "varlock": {
    "loadPath": "./apps/server/"
  }
}
