# Copy to apps/server/.env and apps/web/.env (see README acadêmico)

# --- apps/server/.env ---
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/personal-os
BETTER_AUTH_SECRET=change-me-min-32-characters-long!!
# API origin only (Better Auth mounts at /api/auth). Origin is also used to build
# integration OAuth redirect_uris. Do NOT use the web port (:3001).
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
GOOGLE_GENERATIVE_AI_API_KEY=
INTEGRATION_ENCRYPTION_KEY=change-me-32-byte-integration-key!
# Classic 32-hex Power-Up API key from https://trello.com/power-ups/admin (Chave de API).
# Do NOT use an Atlassian OAuth client id (mixed alphanumeric) or ATOA secret — those break /1/authorize with "App not found".
TRELLO_API_KEY=
TRELLO_API_SECRET=

# Used for Better Auth Google login AND Calendar Connect (linkSocial) — same OAuth client.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client →
# Open the client whose Client ID equals GOOGLE_CLIENT_ID below (not a different client).
# Authorized redirect URIs (exact strings, local):
#
#   REQUIRED — login + Calendar Connect:
#   http://localhost:3000/api/auth/callback/google
#
#   REQUIRED if using Gmail Connect:
#   http://localhost:3000/api/integrations/oauth/gmail/callback
#
#   Do NOT rely on the legacy Calendar route for the Connect button:
#   http://localhost:3000/api/integrations/oauth/google_calendar/callback
#   (blocked server-side; UI uses linkSocial → /api/auth/callback/google)
#
# redirect_uri_mismatch with the REQUIRED URI already registered almost always
# means the Console client ≠ GOOGLE_CLIENT_ID in this file (wrong credential).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (Better Auth login)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic link email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Other OAuth redirect URIs to register with providers:
# Notion:  http://localhost:3000/api/integrations/oauth/notion/callback
# Trello:  http://localhost:3001/oauth/trello  (token fragment callback)

# --- apps/web/.env ---
# VITE_SERVER_URL=http://localhost:3000
