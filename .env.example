# Copy to apps/server/.env and apps/web/.env (see README acadêmico)

# --- apps/server/.env ---
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/personal-os
BETTER_AUTH_SECRET=change-me-min-32-characters-long!!
BETTER_AUTH_URL=http://localhost:3000/api/auth
CORS_ORIGIN=http://localhost:3001
GOOGLE_GENERATIVE_AI_API_KEY=
INTEGRATION_ENCRYPTION_KEY=change-me-32-byte-integration-key!
# Classic Trello Auth (reliable path for REST board/card ops).
# TRELLO_API_KEY = Power-Up API Key (32 hex) from:
#   https://trello.com/power-ups/admin → your Power-Up → Trello Auth / API Key
# Do NOT paste the Atlassian OAuth 2.0 Client ID here — those JWTs are currently
# rejected by api.trello.com as "invalid token" despite successful OAuth exchange.
# Allowed origins on the Power-Up must include the web origin, e.g. http://localhost:3001
# TRELLO_API_SECRET = Power-Up secret (optional; not required for /1/authorize).
TRELLO_API_KEY=
TRELLO_API_SECRET=
# Used for Better Auth Google login AND Calendar tools (same OAuth app).
# Redirect URI: {SERVER}/api/auth/callback/google
# Also register Calendar callback if using Connect button separately:
# {SERVER}/api/integrations/oauth/google_calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (Better Auth login)
# Callback URL: {SERVER}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic link email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# OAuth redirect URIs to register with providers:
# Google Calendar: {SERVER}/api/integrations/oauth/google_calendar/callback
# Gmail:           {SERVER}/api/integrations/oauth/gmail/callback
# Notion:          {SERVER}/api/integrations/oauth/notion/callback
# Trello:          classic Auth returns the token to {WEB}/oauth/trello
#                  (fragment). Add {WEB} origin to Power-Up Allowed origins.

# --- apps/web/.env ---
# VITE_SERVER_URL=http://localhost:3000
