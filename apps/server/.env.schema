# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# OAuth redirects and cookies include this URL — must not be leak-scanned.
# @public @type=url
BETTER_AUTH_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api/auth", undefined)

# Browser Origin header / CORS — not a secret.
# @public @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
GOOGLE_GENERATIVE_AI_API_KEY=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=32)
INTEGRATION_ENCRYPTION_KEY=

# @required=false @type=string(minLength=1)
# Power-Up API key from https://trello.com/power-ups/admin (not the deprecated app-key page)
TRELLO_API_KEY=

# @required=false @type=string(minLength=1)
TRELLO_API_SECRET=

# OAuth authorize URLs embed client_id; mark public so Varlock leak scan allows redirects.
# @public @required=false @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @required=false @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @public @required=false @type=string(minLength=1)
GITHUB_CLIENT_ID=

# @required=false @type=string(minLength=1)
GITHUB_CLIENT_SECRET=

# @public @required=false @type=string(minLength=1)
NOTION_CLIENT_ID=

# @required=false @type=string(minLength=1)
NOTION_CLIENT_SECRET=

# @required=false @type=string(minLength=1)
RESEND_API_KEY=

# @required=false @type=string(minLength=1)
RESEND_FROM_EMAIL=
