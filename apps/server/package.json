{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "env:generate": "varlock codegen",
    "start": "node dist/index.mjs",
    "test": "bun test src"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.15",
    "@ai-sdk/google": "^4.0.64",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.0.3",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@personal-os/api": "workspace:*",
    "@personal-os/auth": "workspace:*",
    "@personal-os/capabilities": "workspace:*",
    "@personal-os/db": "workspace:*",
    "@personal-os/integrations": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "^5.12.3",
    "resend": "^6.31.0",
    "unpdf": "^1.4.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@personal-os/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
