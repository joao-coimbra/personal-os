{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PersonalOS desktop: dialog + scoped filesystem for authorized workspace",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/personal-os-workspaces/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/personal-os-workspaces/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/personal-os-workspaces/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/personal-os-workspaces/**" }]
    }
  ]
}
